# Fast2SMS Credentials (For OTP verification)
# Get your API authorization key from https://www.fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_SENDER_ID=FSTSMS
FAST2SMS_ROUTE=otp
FAST2SMS_MOCK_OTP=true
FAST2SMS_DEFAULT_TEST_OTP=123456

# Google OAuth Credentials
# OAuth 2.0 Web Client ID from Google Cloud Console (used to verify Google tokens sent by Flutter app)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Firebase Cloud Messaging (FCM) Credentials
# Service Account JSON path or Firebase Cloud Messaging Server Key
FIREBASE_CREDENTIALS_PATH=storage/app/firebase/firebase_credentials.json
FIREBASE_SERVER_KEY=your_firebase_server_key_here
FIREBASE_PROJECT_ID=aeee-mobile-app
